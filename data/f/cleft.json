{"id":"cleft","cards":[{"id":"cleft4ccc282e","l":1,"f":"<b>Closed mouth</b> — What you describe?","b":"The <b>lip only</b>","c":"Defect › Cleft Lip"},{"id":"cleftc9b909f8","l":1,"f":"<b>Open mouth with the palate visible</b> — What you describe?","b":"<b>Lip + palate</b>","c":"Defect › Cleft Lip"},{"id":"cleft826fb4c4","l":1,"f":"<b>Palate only</b> — What you describe?","b":"The <b>palate only</b>","c":"Defect › Cleft Lip"},{"id":"cleftd250f890","l":1,"f":"<b>Cosmetic / psychosocial</b> — Effect?","b":"<b>Main problem</b>","c":"Defect › Cleft Lip"},{"id":"cleft7e501dcb","l":1,"f":"<b>Feeding</b> — Effect?","b":"<b>Mild</b> difficulty: infant cannot form an adequate <b>seal</b> around the breast/nipple. Usually managed with appropriate nipples.","c":"Defect › Cleft Lip"},{"id":"clefta96879a6","l":1,"f":"<b>Speech</b> — Effect?","b":"Not significantly affected","c":"Defect › Cleft Lip"},{"id":"cleft32a4341a","l":1,"f":"<b>Hearing</b> — Effect?","b":"Not significantly affected","c":"Defect › Cleft Lip"},{"id":"cleft2962a669","l":2,"f":"Baby with a cleft palate, feeding problems and poor weight gain (5 kg) — to prepare for surgery","b":"<b>insert a nasogastric tube</b> (secure nutrition)","c":"Management"},{"id":"cleftdfc08620","l":2,"f":"Gestational age when the <b>primary palate</b> develops","b":"<b>4–8 weeks</b>","c":"Cleft Palate"},{"id":"cleftec10df2f","l":1,"f":"<b>Soft palate</b> — Position?","b":"Posterior","c":"Cleft Palate › Cleft Palate"},{"id":"cleft7992f79b","l":1,"f":"<b>Soft palate</b> — Bone?","b":"<b>No</b> underlying bone","c":"Cleft Palate › Cleft Palate"},{"id":"cleft14dbed33","l":1,"f":"<b>Hard palate</b> — Position?","b":"Anterior","c":"Cleft Palate › Cleft Palate"},{"id":"cleft7aac54cc","l":1,"f":"<b>Hard palate</b> — Bone?","b":"<b>Bony</b>","c":"Cleft Palate › Cleft Palate"},{"id":"clefte2c19116","l":1,"f":"<b>Oral + nasal mucosa</b> — Normal palate?","b":"Continuous layers separating the two cavities","c":"Cleft Palate › Cleft Palate"},{"id":"cleftb73dfc71","l":1,"f":"<b>Oral + nasal mucosa</b> — Cleft palate?","b":"Separated → <b>oral–nasal communication</b>","c":"Cleft Palate › Cleft Palate"},{"id":"cleft2990dfee","l":1,"f":"<b>Palatal muscles</b> — Normal palate?","b":"Continuous, normally attached","c":"Cleft Palate › Cleft Palate"},{"id":"cleft0d8de97b","l":1,"f":"<b>Palatal muscles</b> — Cleft palate?","b":"<b>Discontinuous / abnormally attached</b>","c":"Cleft Palate › Cleft Palate"},{"id":"cleft70d383df","l":1,"f":"<b>Bone (anterior)</b> — Normal palate?","b":"Present under the hard palate","c":"Cleft Palate › Cleft Palate"},{"id":"cleft107f7fd2","l":1,"f":"<b>Bone (anterior)</b> — Cleft palate?","b":"Anterior clefts may have <b>bony deficiency</b>","c":"Cleft Palate › Cleft Palate"},{"id":"cleft45283900","l":2,"f":"4-month-old, <b>bilateral complete</b> cleft, very short columella, small prolabium — most difficult part of the repair","b":"<b>nasal position</b> (columella/nose)","c":"Cleft Palate › Cleft Palate"},{"id":"cleftbf1b036a","l":1,"f":"<b>Feeding</b> — Mechanism?","b":"Cannot form a proper <b>seal</b>; ineffective swallowing / suction","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleftf4e5ef0c","l":1,"f":"<b>Feeding</b> — Result?","b":"<b>Nasal regurgitation</b>, poor feeding","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft931ba5d4","l":1,"f":"<b>Feeding</b> — Management / follow-up?","b":"<b>Special nipples</b>, <b>upright</b> feeding, <b>frequent smaller</b> feeds","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft00da9cbc","l":1,"f":"<b>Speech</b> — Mechanism?","b":"Palate generates normal <b>oral pressure</b>; cleft lets air escape into the nose","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft13e00ee6","l":1,"f":"<b>Speech</b> — Result?","b":"<b>Speech abnormalities</b>","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft19108016","l":1,"f":"<b>Speech</b> — Management / follow-up?","b":"<b>Speech therapy</b>","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"clefta4610ed6","l":1,"f":"<b>Ear / hearing</b> — Mechanism?","b":"Palatal dysfunction disturbs <b>middle-ear</b> <b>pressure regulation</b>","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleftdf49beb6","l":1,"f":"<b>Ear / hearing</b> — Result?","b":"<b>Recurrent middle-ear</b> <b>problems / infections</b>","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft1815e331","l":1,"f":"<b>Ear / hearing</b> — Management / follow-up?","b":"<b>ENT</b> follow-up","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft9712a391","l":1,"f":"<b>Dental</b> — Mechanism?","b":"Abnormal palate / <b>alveolar</b> structures","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft75db9c3c","l":1,"f":"<b>Dental</b> — Result?","b":"<b>Dental problems</b>","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleft3a449497","l":1,"f":"<b>Dental</b> — Management / follow-up?","b":"<b>Dentistry</b> follow-up","c":"Clinical Impact › Clinical Effects of Cleft Palate"},{"id":"cleftb691f028","l":1,"f":"<b>Cleft lip</b> — Diagnosis?","b":"Side + extent, e.g. <b>left unilateral complete</b>; extends lip → nose","c":"Clinical Impact › Exam Focus: Lip vs Palate Side by Side"},{"id":"cleftdcc55c68","l":2,"f":"Most important factor in deciding cleft palate surgery","b":"<b>dental and mouth examination</b> (the mouth/palate must be big enough; age 12–18 months is the guide)","c":"Management › Cleft Palate Repair"},{"id":"cleftbb315111","l":2,"f":"5-year-old after palate repair with <b>nasal speech not responding to exercises</b>","b":"<b>velopharyngeal insufficiency</b>","c":"Management › Timing at a Glance"},{"id":"cleft942918e5","l":2,"f":"Timing of bone grafting in cleft palate","b":"<b>when the canine teeth come out</b>","c":"Management › Timing at a Glance"},{"id":"cleft17ec97f0","l":2,"f":"Most common site","b":"<b>left</b>","c":"Management › Mastery Checklist"}]}