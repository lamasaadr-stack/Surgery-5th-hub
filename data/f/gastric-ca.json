","c":"Diagnostic Laparoscopy"},{"id":"gastri5cb5c97e","l":1,"f":"<b>T NX</b> — Primary Tumor?","b":"Regional lymph node(s) cannot be assessed","c":"Diagnostic Laparoscopy"},{"id":"gastri5090e8ee","l":1,"f":"<b>T N0</b> — Primary Tumor?","b":"No regional lymph node metastasis","c":"Diagnostic Laparoscopy"},{"id":"gastri8531b763","l":1,"f":"<b>T N1</b> — Primary Tumor?","b":"Metastasis in one or two regional lymph nodes","c":"Diagnostic Laparoscopy"},{"id":"gastri6ce2bb36","l":1,"f":"<b>T N2</b> — Primary Tumor?","b":"Metastasis in three to six regional lymph nodes","c":"Diagnostic Laparoscopy"},{"id":"gastri326e170d","l":1,"f":"<b>T N3</b> — Primary Tumor?","b":"Metastasis in seven or more regional lymph nodes","c":"Diagnostic Laparoscopy"},{"id":"gastria8e0adfb","l":1,"f":"<b>T N3a</b> — Primary Tumor?","b":"Metastasis in seven to 15 regional lymph nodes","c":"Diagnostic Laparoscopy"},{"id":"gastribd11b9e1","l":1,"f":"<b>T N3b</b> — Primary Tumor?","b":"Metastasis in 16 or more regional lymph nodes","c":"Diagnostic Laparoscopy"},{"id":"gastrid675dcc4","l":1,"f":"<b>T M</b> — Primary Tumor?","b":"Distant Metastasis","c":"Diagnostic Laparoscopy"},{"id":"gastri951f1155","l":1,"f":"<b>T M0</b> — Primary Tumor?","b":"No distant metastasis","c":"Diagnostic Laparoscopy"},{"id":"gastri8050d8fb","l":1,"f":"<b>T M1</b> — Primary Tumor?","b":"Distant metastasis","c":"Diagnostic Laparoscopy"},{"id":"gastrieba377ad","l":1,"f":"<b>T G</b> — Primary Tumor?","b":"Histologic Grade","c":"Diagnostic Laparoscopy"},{"id":"gastri2ba66653","l":1,"f":"<b>T GX</b> — Primary Tumor?","b":"Grade cannot be assessed","c":"Diagnostic Laparoscopy"},{"id":"gastrid48d48fb","l":1,"f":"<b>T G1</b> — Primary Tumor?","b":"Well differentiated","c":"Diagnostic Laparoscopy"},{"id":"gastri184792ec","l":1,"f":"<b>T G2</b> — Primary Tumor?","b":"Moderately differentiated","c":"Diagnostic Laparoscopy"},{"id":"gastriab5880af","l":1,"f":"<b>T G3</b> — Primary Tumor?","b":"Poorly differentiated, undifferentiated