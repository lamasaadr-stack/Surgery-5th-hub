{"id":"oncology","cards":[{"id":"oncolob291c0e7","l":1,"f":"<b>Hypertrophy</b> — Definition?","b":"↑ cell <b>size</b>, no change in cell number","c":"Basic Terminology"},{"id":"oncolo86544825","l":1,"f":"<b>Hypertrophy</b> — Key point?","b":"Cardiac hypertrophy in chronic hypertension (persistent ↑ pressure/resistance)","c":"Basic Terminology"},{"id":"oncolo25427916","l":1,"f":"<b>Hyperplasia</b> — Definition?","b":"↑ cell <b>number</b>, usually a regulated stimulus (e.g. estrogen/androgen)","c":"Basic Terminology"},{"id":"oncolo6d629a5e","l":1,"f":"<b>Hyperplasia</b> — Key point?","b":"<b>Regulated and reversible</b> once stimulus removed — unlike neoplasia","c":"Basic Terminology"},{"id":"oncolo152121ed","l":1,"f":"<b>Neoplasia</b> — Definition?","b":"Unregulated, <b>irreversible</b> tissue growth","c":"Basic Terminology"},{"id":"oncolob96095d4","l":1,"f":"<b>Neoplasia</b> — Key point?","b":"Usually <b>monoclonal</b> — one mutated cell accumulates further mutations over years","c":"Basic Terminology"},{"id":"oncolo00e6c0ce","l":1,"f":"<b>Metaplasia</b> — Definition?","b":"Replacement of one <b>differentiated</b> cell type by another differentiated type","c":"Basic Terminology"},{"id":"oncoloe10a1c5c","l":1,"f":"<b>Metaplasia</b> — Key point?","b":"Barrett esophagus: squamous → columnar (chronic acid reflux)","c":"Basic Terminology"},{"id":"oncoloea33cd78","l":1,"f":"<b>Dysplasia</b> — Definition?","b":"Abnormal/disordered proliferation with cytologic atypia (pleomorphism)","c":"Basic Terminology"},{"id":"oncolod2a44ceb","l":1,"f":"<b>Dysplasia</b> — Key point?","b":"End result of persistent metaplasia; premalignant if stimulus persists","c":"Basic Terminology"},{"id":"oncolocab251b6","l":1,"f":"<b>Benign</b> — Differentiation?","b":"Usually well differentiated","c":"Basic Terminology"},{"id":"oncolocc4af500","l":1,"f":"<b>Malignant</b> — Differentiation?","b":"Variable / poorly differentiated","c":"Basic Terminology"},{"id":"oncolo4f6dcd45","l":1,"f":"<b>Benign</b> — Growth?","b":"Usually slow","c":"Basic Terminology"},{"id":"oncolo8c0c458b","l":1,"f":"<b>Malignant</b> — Growth?","b":"Often faster","c":"Basic Terminology"},{"id":"oncoloce86a810","l":1,"f":"<b>Benign</b> — Local invasion?","b":"No","c":"Basic Terminology"},{"id":"oncoloe2c5c2de","l":1,"f":"<b>Malignant</b> — Local invasion?","b":"Yes","c":"Basic Terminology"},{"id":"oncolob7ab2bb8","l":1,"f":"<b>Benign</b> — Metastasis?","b":"No","c":"Basic Terminology"},{"id":"oncolob57d3fc2","l":1,"f":"<b>Malignant</b> — Metastasis?","b":"Possible","c":"Basic Terminology"},{"id":"oncolo217e1c3e","l":1,"f":"<b>Benign</b> — Recurrence?","b":"Usually uncommon","c":"Basic Terminology"},{"id":"oncolo30c4c7ce","l":1,"f":"<b>Malignant</b> — Recurrence?","b":"May occur","c":"Basic Terminology"},{"id":"oncolo579d0b06","l":1,"f":"<b>Benign</b> — Clinical impact?","b":"Usually local","c":"Basic Terminology"},{"id":"oncolo30b5f349","l":1,"f":"<b>Malignant</b> — Clinical impact?","b":"Local + systemic","c":"Basic Terminology"},{"id":"oncolo54276a36","l":1,"f":"<b>Benign</b> — Invasion?","b":"Localized, no significant invasion","c":"Basic Terminology"},{"id":"oncolo0a942f1e","l":1,"f":"<b>Malignant</b> — Invasion?","b":"Local invasion","c":"Basic Terminology"},{"id":"oncolo85624d7f","l":2,"f":"<b>Lung cancer screening</b>","b":"<b>annual low-dose CT</b> for age <b>50–80</b> with <b>≥ 20 pack-years</b> who smoke now or quit within 15 years: e.g. a 52-year-old, 30 pack-years, quit 10 years ago ; the only candidate among the choices was the <b>51-year-old with 30 pack-years</b> (others too young or too few pack-years)","c":"Carcinogenesis"},{"id":"oncolo0a287d5b","l":1,"f":"<b>BRCA1 / BRCA2 (inherited)</b> — Associated cancer(s)?","b":"Breast / ovarian cancer predisposition","c":"Carcinogenesis"},{"id":"oncolof2153be3","l":1,"f":"<b>APC mutation</b> — Associated cancer(s)?","b":"Earliest event in the classic adenoma–carcinoma sequence (colorectal cancer)","c":"Carcinogenesis"},{"id":"oncolo10d8b2a3","l":1,"f":"<b>Processed / smoked diet</b> — Associated cancer(s)?","b":"GI / gastric malignancy","c":"Carcinogenesis"},{"id":"oncolob3527cf9","l":1,"f":"<b>Asbestos</b> — Associated cancer(s)?","b":"Mesothelioma","c":"Carcinogenesis"},{"id":"oncolo25e03107","l":1,"f":"<b>Aromatic dyes</b> — Associated cancer(s)?","b":"Bladder cancer","c":"Carcinogenesis"},{"id":"oncolo59cb6a3c","l":1,"f":"<b>Smoking / alcohol</b> — Associated cancer(s)?","b":"Multiple carcinogenic exposures","c":"Carcinogenesis"},{"id":"oncolo47b924cb","l":1,"f":"<b>Radiation (therapeutic or environmental)</b> — Associated cancer(s)?","b":"Secondary malignancy, often <b>~20 years later</b> (e.g. angiosarcoma in a previously irradiated field)","c":"Carcinogenesis"},{"id":"oncolo87b2032e","l":1,"f":"<b>Risk factor HPV</b> — Associated cancer(s)?","b":"Cervical &amp; anal cancer — screen","c":"Carcinogenesis"},{"id":"oncoloffe2298c","l":1,"f":"<b>Hepatitis viruses</b> — Associated cancer(s)?","b":"Hepatocellular carcinoma (HCC)","c":"Carcinogenesis"},{"id":"oncolocd0bd619","l":1,"f":"<b>Hormonal exposure</b> — Associated cancer(s)?","b":"Hormone-sensitive malignancies (e.g. prostate)","c":"Carcinogenesis"},{"id":"oncoloe440db18","l":1,"f":"<b>Increasing age</b> — Associated cancer(s)?","b":"↑ cumulative mutations + ↑ DNA-repair failure","c":"Carcinogenesis"},{"id":"oncolo9b245659","l":1,"f":"<b>Somatic mutation</b> — Location?","b":"Only within tumor cells","c":"Genatic Mutation"},{"id":"oncolo55a0f75e","l":1,"f":"<b>Germline mutation</b> — Location?","b":"Throughout the body's normal cells","c":"Genatic Mutation"},{"id":"oncolof51d00d8","l":1,"f":"<b>Somatic mutation</b> — Inherited??","b":"Not necessarily","c":"Genatic Mutation"},{"id":"oncolo2717d091","l":1,"f":"<b>Germline mutation</b> — Inherited??","b":"Yes — hereditary predisposition","c":"Genatic Mutation"},{"id":"oncolo2791d431","l":1,"f":"<b>Somatic mutation</b> — Testing?","b":"Tumor tissue (guides targeted/systemic therapy)","c":"Genatic Mutation"},{"id":"oncolocb53e3e4","l":1,"f":"<b>Germline mutation</b> — Testing?","b":"<b>Blood or normal tissue</b>, not only tumor","c":"Genatic Mutation"},{"id":"oncolo72e431d2","l":1,"f":"<b>Somatic mutation</b> — Implication?","b":"Informs treatment selection","c":"Genatic Mutation"},{"id":"oncolo6897d793","l":1,"f":"<b>Germline mutation</b> — Implication?","b":"↑ risk of multiple different cancers","c":"Genatic Mutation"},{"id":"oncolo9b490437","l":2,"f":"HCC on cirrhosis within Milan criteria (single ≤5 cm, Child B)","b":"<b>liver transplant</b>","c":"Genatic Mutation"},{"id":"oncolo98fcdd8c","l":1,"f":"<b>Breast</b> — Screening modality?","b":"Mammography","c":"Surgical Oncology: Prevention"},{"id":"oncolo16fa1217","l":1,"f":"<b>Cervical</b> — Screening modality?","b":"Pap smear / cervical screening","c":"Surgical Oncology: Prevention"},{"id":"oncolofa917543","l":1,"f":"<b>Colorectal</b> — Screening modality?","b":"Stool-based testing and/or colonoscopy, depending on risk","c":"Surgical Oncology: Prevention"},{"id":"oncolo99fb39f9","l":2,"f":"Average-risk colorectal screening (no family history)","b":"<b>colonoscopy every 10 years starting at 45–50</b>","c":"Surgical Oncology: Prevention"},{"id":"oncolo9cad3e5d","l":2,"f":"62-year-old with hematochezia and 3rd-degree hemorrhoids","b":"<b>colonoscopy first</b> (rule out cancer before treating the hemorrhoids)","c":"Surgical Oncology: Prevention"},{"id":"oncoloc8df084e","l":2,"f":"70-year-old with <b>bright red blood mixed with stool, weight loss, constipation, pallor</b>","b":"<b>colon cancer (adenocarcinoma)</b>","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo20e1d04f","l":2,"f":"Pancreatic head tumor","b":"<b>CA 19-9</b>","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo9499b287","l":2,"f":"Palpable gallbladder (Courvoisier)","b":"<b>tumor of the head of the pancreas</b>, not a CBD stone","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloa54a798b","l":2,"f":"Locally advanced low rectal cancer (T3N1M0), not obstructed","b":"<b>start with (chemo)radiation</b> (neoadjuvant), not upfront surgery","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloa358fc46","l":1,"f":"<b>Tumor marker CEA</b> — Association / use?","b":"Colorectal cancer; baseline/prognostic/follow-up","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo4667140c","l":1,"f":"<b>CA 19-9</b> — Association / use?","b":"Pancreatic / biliary malignancy","c":"Surgical Oncology: Diagnosis"},{"id":"oncolodc9a4d9e","l":1,"f":"<b>CA-125</b> — Association / use?","b":"Ovarian cancer; may rise with peritoneal carcinomatosis","c":"Surgical Oncology: Diagnosis"},{"id":"oncolod6cb67f6","l":1,"f":"<b>Tumor marker AFP</b> — Association / use?","b":"Hepatocellular carcinoma (HCC)","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo1a6aa7a6","l":1,"f":"<b>Tumor marker PSA</b> — Association / use?","b":"Prostate cancer","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloe2307b8a","l":1,"f":"<b>Calcitonin</b> — Association / use?","b":"Medullary thyroid carcinoma","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo51c27418","l":1,"f":"<b>Thyroglobulin</b> — Association / use?","b":"Follow-up of differentiated thyroid cancer","c":"Surgical Oncology: Diagnosis"},{"id":"oncolob0713882","l":2,"f":"Diagnostic pre-treatment tumor marker in thyroid cancer (keyed)","b":"<b>calcitonin</b> (medullary); thyroglobulin is for <b>follow-up after total thyroidectomy</b> in differentiated cancer","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo073dc0e0","l":1,"f":"<b>Category 0</b> — Meaning?","b":"Incomplete/not assessable → additional imaging required","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo09e294bd","l":1,"f":"<b>Category 1</b> — Meaning?","b":"Negative","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo60423ff3","l":1,"f":"<b>Category 2</b> — Meaning?","b":"Benign","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloaedd9076","l":1,"f":"<b>Category 3</b> — Meaning?","b":"Probably benign → short-interval follow-up","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo7fbc1c57","l":1,"f":"<b>Category 4</b> — Meaning?","b":"Suspicious abnormality","c":"Surgical Oncology: Diagnosis"},{"id":"oncolod23f366e","l":1,"f":"<b>Category 5</b> — Meaning?","b":"Highly suggestive of malignancy","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo19eb415d","l":1,"f":"<b>Category 6</b> — Meaning?","b":"Biopsy-proven malignancy","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloab863d0c","l":1,"f":"<b>Incisional</b> — Description?","b":"Removes part of the tumor; diagnostic, not definitive treatment","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo04120ed1","l":1,"f":"<b>Excisional</b> — Description?","b":"Removes the entire lesion; may also be definitive treatment for a small, appropriately selected lesion","c":"Surgical Oncology: Diagnosis"},{"id":"oncolofdb4de77","l":1,"f":"<b>Core needle</b> — Description?","b":"Obtains a tissue core — preserves architecture, more histologic information","c":"Surgical Oncology: Diagnosis"},{"id":"oncolocdd4c76b","l":1,"f":"<b>Punch</b> — Description?","b":"Used for selected superficial lesions","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloc6a9f99e","l":1,"f":"<b>Endoscopic</b> — Description?","b":"Samples mucosa/submucosa during endoscopy","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloa00a4497","l":1,"f":"<b>Type FNA</b> — Description?","b":"Obtains cells only (cytology); limited architecture — gives cell type only, not full histologic detail","c":"Surgical Oncology: Diagnosis"},{"id":"oncolo748e8dd0","l":2,"f":"Submucosal gastric mass with normal mucosa and central ulceration, presenting with hematemesis","b":"<b>GIST</b> (CD117)","c":"Surgical Oncology: Diagnosis"},{"id":"oncolod24c311f","l":2,"f":"Thyroid nodule on exam/US","b":"next step <b>FNA</b>","c":"Surgical Oncology: Diagnosis"},{"id":"oncoloc9f2cc69","l":2,"f":"Hashimoto's thyroiditis + rapidly enlarging diffuse goitre","b":"<b>thyroid lymphoma</b>","c":"Surgical Oncology: Histopathology"},{"id":"oncolo84274e49","l":1,"f":"<b>Cytokeratin</b> — Supports?","b":"Carcinoma","c":"Surgical Oncology: Histopathology"},{"id":"oncolof2a97015","l":1,"f":"<b>CD45</b> — Supports?","b":"Lymphoid tumors / lymphoma","c":"Surgical Oncology: Histopathology"},{"id":"oncolo2d15a428","l":1,"f":"<b>CDX2 / SATB2</b> — Supports?","b":"GI / colorectal origin","c":"Surgical Oncology: Histopathology"},{"id":"oncolofbfacd2f","l":1,"f":"<b>ER, PR, HER2 (breast)</b> — Supports?","b":"Suitability for hormone/targeted therapy","c":"Surgical Oncology: Histopathology"},{"id":"oncoloa4dc63f0","l":1,"f":"<b>IHC marker CK7</b> — Common association / use?","b":"Common in breast, lung, ovarian, pancreatobiliary and urothelial tumors","c":"Surgical Oncology: Histopathology"},{"id":"oncolof037061e","l":1,"f":"<b>CK20</b> — Common association / use?","b":"Common in colorectal and urothelial tumors","c":"Surgical Oncology: Histopathology"},{"id":"oncoloe61e5f7d","l":1,"f":"<b>CDX2</b> — Common association / use?","b":"Intestinal / colorectal differentiation","c":"Surgical Oncology: Histopathology"},{"id":"oncolo090b6b4e","l":1,"f":"<b>SATB2</b> — Common association / use?","b":"Colorectal / appendiceal origin","c":"Surgical Oncology: Histopathology"},{"id":"oncolo1e420cb4","l":1,"f":"<b>TTF-1</b> — Common association / use?","b":"Lung adenocarcinoma and thyroid tumors","c":"Surgical Oncology: Histopathology"},{"id":"oncolo052e10fb","l":1,"f":"<b>PAX8</b> — Common association / use?","b":"Renal, thyroid and Müllerian tumors","c":"Surgical Oncology: Histopathology"},{"id":"oncoloe40da8bb","l":1,"f":"<b>ER / PR</b> — Common association / use?","b":"Breast and gynecologic tumors; also predictive markers for hormonal therapy","c":"Surgical Oncology: Histopathology"},{"id":"oncolob411df3f","l":1,"f":"<b>HER2</b> — Common association / use?","b":"Breast and selected gastric/GEJ and other cancers; predictive for targeted therapy","c":"Surgical Oncology: Histopathology"},{"id":"oncolod1d68c33","l":1,"f":"<b>PSA / NKX3.1</b> — Common association / use?","b":"Prostatic origin","c":"Surgical Oncology: Histopathology"},{"id":"oncolo6639bfae","l":1,"f":"<b>Synaptophysin</b> — Common association / use?","b":"Neuroendocrine differentiation","c":"Surgical Oncology: Histopathology"},{"id":"oncolo3871da16","l":1,"f":"<b>Chromogranin A</b> — Common association / use?","b":"Neuroendocrine differentiation","c":"Surgical Oncology: Histopathology"},{"id":"oncolo5103fecc","l":1,"f":"<b>S100 / SOX10</b> — Common association / use?","b":"Melanocytic and neural differentiation","c":"Surgical Oncology: Histopathology"},{"id":"oncolo389f2ecf","l":1,"f":"<b>Melan-A / HMB45</b> — Common association / use?","b":"Melanoma / melanocytic tumors","c":"Surgical Oncology: Histopathology"},{"id":"oncolob2f8554d","l":1,"f":"<b>CD117 (KIT)</b> — Common association / use?","b":"GIST","c":"Surgical Oncology: Histopathology"},{"id":"oncoload8a7789","l":1,"f":"<b>Desmin</b> — Common association / use?","b":"Smooth-muscle differentiation, e.g. leiomyosarcoma","c":"Surgical Oncology: Histopathology"},{"id":"oncolocd430f01","l":2,"f":"Colon (splenic-flexure) adenocarcinoma","b":"staging by <b>CT chest, abdomen and pelvis</b>","c":"Surgical Oncology: Staging"},{"id":"oncolo83922a5d","l":2,"f":"Biopsy-proven gastric adenocarcinoma","b":"next step <b>CT scan</b> (staging) — EUS and diagnostic laparoscopy come after","c":"Surgical Oncology: Staging"},{"id":"oncolobf14ed76","l":1,"f":"<b>Stage T1</b> — Extent of invasion?","b":"Submucosa","c":"Surgical Oncology: Staging"},{"id":"oncoloed0499bc","l":1,"f":"<b>Stage T2</b> — Extent of invasion?","b":"Muscularis propria","c":"Surgical Oncology: Staging"},{"id":"oncolo5dae6324","l":1,"f":"<b>Stage T3</b> — Extent of invasion?","b":"Beyond muscularis propria into mesorectal/perirectal tissue (depth matters)","c":"Surgical Oncology: Staging"},{"id":"oncolo0a269340","l":1,"f":"<b>Stage T4a</b> — Extent of invasion?","b":"Penetrates the visceral peritoneal surface","c":"Surgical Oncology: Staging"},{"id":"oncolo85483e37","l":1,"f":"<b>Stage T4b</b> — Extent of invasion?","b":"Directly invades adjacent organs/structures","c":"Surgical Oncology: Staging"},{"id":"oncolof63e9b88","l":1,"f":"<b>Most intra-abdominal GI tumors</b> — Typical spread pattern?","b":"Portal venous drainage → <b>liver</b> is a common hematogenous site","c":"Surgical Oncology: Staging"},{"id":"oncolo51e741b4","l":1,"f":"<b>Rectal cancer (lower)</b> — Typical spread pattern?","b":"Venous drainage via iliac veins → <b>lung</b> metastases can occur without liver metastases","c":"Surgical Oncology: Staging"},{"id":"oncolof993cd7b","l":1,"f":"<b>Renal / retroperitoneal tumors</b> — Typical spread pattern?","b":"Systemic venous drainage → lung common","c":"Surgical Oncology: Staging"},{"id":"oncolo5b3eecaa","l":1,"f":"<b>Prostate cancer</b> — Typical spread pattern?","b":"Bone","c":"Surgical Oncology: Staging"},{"id":"oncolob5876678","l":1,"f":"<b>Breast cancer</b> — Typical spread pattern?","b":"Bone, lung, brain","c":"Surgical Oncology: Staging"},{"id":"oncolob65a8078","l":1,"f":"<b>Renal cell carcinoma</b> — Typical spread pattern?","b":"Lung / bone","c":"Surgical Oncology: Staging"},{"id":"oncolo8f5ffb21","l":1,"f":"<b>Ovarian cancer</b> — Typical spread pattern?","b":"Peritoneal spread, may involve pleura","c":"Surgical Oncology: Staging"},{"id":"oncolo3086502d","l":1,"f":"<b>Testicular cancer</b> — Typical spread pattern?","b":"Retroperitoneal lymph nodes","c":"Surgical Oncology: Staging"},{"id":"oncoloc4097e99","l":1,"f":"<b>Gastric cancer</b> — Typical spread pattern?","b":"Ovary (<b>Krukenberg tumor</b>); left supraclavicular (<b>Virchow</b>) node","c":"Surgical Oncology: Staging"},{"id":"oncolocc18f240","l":2,"f":"Obstructing rectosigmoid/low rectal cancer <b>with liver and lung metastases</b>","b":"<b>diverting stoma (transverse colostomy)</b>","c":"Surgical Oncology: Surgical management"},{"id":"oncolobc72fb41","l":2,"f":"\"When is she cured?\"","b":"<b>a normal duration of life without further clinical or radiological evidence</b> of cancer","c":"Surgical Oncology: Surgical management"},{"id":"oncolo14776dbc","l":1,"f":"<b>Margin R0</b> — Meaning?","b":"No residual tumor — microscopically negative margin (goal of complete oncologic resection)","c":"Surgical Oncology: Surgical management"},{"id":"oncolofa530e74","l":1,"f":"<b>Margin R1</b> — Meaning?","b":"Microscopic residual tumor / positive microscopic margin","c":"Surgical Oncology: Surgical management"},{"id":"oncolo948ebd69","l":1,"f":"<b>Margin R2</b> — Meaning?","b":"Macroscopic residual tumor","c":"Surgical Oncology: Surgical management"},{"id":"oncolof9e10c71","l":1,"f":"<b>Neoadjuvant</b> — Definition?","b":"Treatment <b>before</b> surgery","c":"Surgical Oncology: Surgical management"},{"id":"oncolo30b2221f","l":1,"f":"<b>Adjuvant</b> — Definition?","b":"Treatment <b>after</b> surgery","c":"Surgical Oncology: Surgical management"},{"id":"oncolo9c3ffb04","l":1,"f":"<b>Perioperative</b> — Definition?","b":"Treatment both before and after surgery","c":"Surgical Oncology: Surgical management"},{"id":"oncolof8fc6476","l":1,"f":"<b>Definitive therapy</b> — Definition?","b":"Intended to provide curative control without another planned definitive modality","c":"Surgical Oncology: Surgical management"},{"id":"oncoloa84aae9e","l":1,"f":"<b>Curative intent</b> — Definition?","b":"Aims to eradicate cancer","c":"Surgical Oncology: Surgical management"},{"id":"oncolo143ac523","l":1,"f":"<b>Palliative treatment</b> — Definition?","b":"Aims to control symptoms/disease and improve quality of life","c":"Surgical Oncology: Surgical management"},{"id":"oncolo0aefa7cf","l":1,"f":"<b>Maintenance therapy</b> — Definition?","b":"Lower-intensity, prolonged therapy to maintain control and delay progression","c":"Surgical Oncology: Surgical management"},{"id":"oncolofc4a9f7d","l":2,"f":"Neoadjuvant radiotherapy role in rectal cancer","b":"<b>down-stage the tumor</b> ; neoadjuvant radiotherapy = <b>local control</b>","c":"Surgical Oncology: Surgical management"},{"id":"oncolodb2330f4","l":2,"f":"<b>Marjolin ulcer</b>","b":"<b>SCC</b> arising in a chronic scar/burn","c":"Other organ facts asked under oncology"},{"id":"oncoloc90bf27b","l":2,"f":"Picture of an ulcerated skin lesion","b":"<b>SCC</b>","c":"Other organ facts asked under oncology"}]}